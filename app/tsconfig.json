{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist-tsc",
    "noEmit": true
  },
  "include": ["src", "tests"]
}
